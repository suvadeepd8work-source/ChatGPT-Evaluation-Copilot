# --- LLM Providers ---
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Search & Fact Checking ---
SERPER_API_KEY=your_serper_dev_key_here
GOOGLE_SEARCH_API_KEY=your_google_search_key_here
GOOGLE_SEARCH_CX=your_search_engine_id_here

# --- Connection Settings ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development # production, development

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/evaluation_db

# --- Application Settings ---
SECRET_KEY=generate_a_secure_random_string_here
PORT=8000

# --- Feature Flags ---
ENABLE_SOURCE_AUDITOR=true
ENABLE_DEBIASING_UI=true
STAKE_DETECTION_THRESHOLD=0.7
